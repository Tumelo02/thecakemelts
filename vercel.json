{
  "redirects": [
    {
      "source": "/(.*)",
      "missing": [
        { "type": "host", "value": "thecakemelts.co.za" }
      ],
      "destination": "https://thecakemelts.co.za/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/cake_images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(css|js|fonts)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
